# Copy to .env (gitignored) for local development. The backend reads .env from
# its working directory (the repo root); real environment variables win.
# Every variable is documented in docs/administration.md.

# Required: signs session cookies (32+ characters), e.g. `openssl rand -hex 32`
SESSION_SECRET_KEY=

# Local dev runs over plain http, where a Secure cookie would be dropped.
SESSION_COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173

# Zitadel OIDC application, for real login. Leave OIDC_ISSUER_URL unset to use
# the dev-login bypass instead (DEV_AUTH_BYPASS=true): the app refuses to start
# with both, since a configured identity provider means a real deployment.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Through the Vite proxy, so the session cookie is set on the SPA's origin.
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# ntfy push notifications (optional)
NTFY_URL=
NTFY_TOPIC=greenthumb
NTFY_TOKEN=
