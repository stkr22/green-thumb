{
	"name": "greenthumb-dev-environment",
	"image": "ghcr.io/stkr22/devcontainer-python-container:1.4.0@sha256:8830e371adfceaf5c17f8fa261aafea899fbcf940a0b72b76b005500a5279b99",
    "features": {
        // Pinned to match [tool.uv] required-version in pyproject.toml: a newer
        // uv minor makes `uv sync` refuse to run, which silently broke
        // postCreateCommand before. Bump both together.
        "ghcr.io/stkr22/devcontainer-features/uv:1.2.1": {
            "version": "0.13.7"
        },
		"ghcr.io/devcontainer-community/devcontainer-features/starship.rs:1": {},
		"ghcr.io/devcontainers/features/node:2.1.0": {
		"version": "lts"
		},
		"ghcr.io/stkr22/devcontainer-features/claude-code:4.1.0": {}
    },
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"samuelcolvin.jinjahtml",
				"streetsidesoftware.code-spell-checker",
				"christian-kohler.path-intellisense",
				"charliermarsh.ruff",
				"astral-sh.ty",
				"tamasfe.even-better-toml",
				"github.vscode-github-actions",
				"oderwat.indent-rainbow",
				"mhutchie.git-graph",
				"vivaxy.vscode-conventional-commits"
			],
			"settings": {
				"files.trimFinalNewlines": true,
				"files.trimTrailingWhitespace": true,
				"files.insertFinalNewline": true,
				"[python]": {
					"editor.formatOnSave": true,
					"editor.codeActionsOnSave": {
						"source.fixAll": "explicit",
						"source.organizeImports": "explicit"
					},
					"editor.defaultFormatter": "charliermarsh.ruff"
				},
				"python.defaultInterpreterPath": "/workspaces/.venv/bin/python",
				"python.testing.unittestEnabled": false,
				"python.testing.pytestEnabled": true,
				"cSpell.files": [
					"src"
				]
			}
		}
	},
    "remoteEnv": {
        "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}"
    },
	// Frontend deps and the Playwright browser are installed here too, so the
	// build and e2e commands from AGENTS.md work in a fresh container.
	"postCreateCommand": "uv sync --group dev && uv tool run pre-commit install --install-hooks && cd frontend && npm ci && npx playwright install --with-deps chromium"
}
